{
  "name": "nextjs-examples",
  "version": "1.0.0",
  "description": "Nextjs examples",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "start": "run-p -l start:dev start:api-server",
    "start:dev": "next dev",
    "build": "rimraf .next && next build",
    "start:prod": "next start -p 8080",
    "start:api-server": "cd api-server && npm run mock-server"
  },
  "author": "Lemoncode",
  "license": "MIT",
  "dependencies": {
    "next": "16.4.2",
    "normalize.css": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "npm-run-all": "4.1.5",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  }
}
